# Copy this file to .env and replace every placeholder. Never commit .env.

# Public Add/Search API authentication chosen by the participant.
AML_API_KEY=replace-with-a-long-random-secret

# Singapore Model Studio workspace credentials for text-embedding-v4.
# Create the API key in Singapore and use the matching workspace ID.
DASHSCOPE_API_KEY=replace-with-your-singapore-model-studio-api-key
DASHSCOPE_BASE_URL=https://replace-with-workspace-id.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
