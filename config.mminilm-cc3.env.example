# Equal-weight BM25 / BM25-free rules / multilingual MiniLM, experimental.
# Provision the same locked model assets and mount them read-only.
# Supply authentication separately; use a fresh isolated DB for evaluation.
AML_FLAG_VECTOR=0
AML_FLAG_SEMANTIC_RERANK=0
AML_FLAG_PAIR_RERANK=1
AML_FLAG_PAIR_TOP20_PROTECT=0
AML_FLAG_PAIR_EXACT_PROTECT=0
AML_PAIR_BACKEND=aml_retriever.onnx_pair_backend:create_backend
AML_PAIR_MODEL_PATH=/models/mmarco-mMiniLMv2-L12-H384-v1
AML_PAIR_ONNX_FILE=onnx/model_quint8_avx2.onnx
AML_PAIR_RERANK_MODE=cc3
AML_PAIR_RERANK_POOL=100
AML_PAIR_MAX_LENGTH=512
AML_PAIR_BATCH_SIZE=1
AML_PAIR_THREADS=1
AML_INCLUDE_PROVENANCE=1
AML_MAX_INFLIGHT=32
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
# Weights are fixed at 1/3 each. AML_PAIR_RRF_WEIGHT/K do not tune cc3.
